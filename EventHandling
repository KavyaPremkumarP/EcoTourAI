                document.getElementById('res-pass-id').textContent = `PASS ID: ${record.passId}`;
                document.getElementById('epass-result').classList.remove('hidden');
                document.getElementById('epass-result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            } catch (e) { /* ignore */ }
        }

        function clearSavedPass() {
            try {
                localStorage.removeItem('ootyEpass');
                refreshSavedPassBanner();
            } catch (e) { /* ignore */ }
        }

        /* =========================================================
           HTML5 API 3: WEB NOTIFICATIONS API
           Fires a native OS-level notification whenever the AI
           scanner flags a prohibited plastic item, in addition to
           the in-page modal.
        ========================================================= */
        function sendPlasticNotification(title, conf) {
            if (!('Notification' in window)) return;

            const showNotif = function () {
                new Notification('🚨 Nilgiris Checkpost AI Alert', {
                    body: `${title} detected with ${conf} confidence. Please swap for an approved eco product.`,
                });
            };

            if (Notification.permission === 'granted') {
                showNotif();
            } else if (Notification.permission !== 'denied') {
                Notification.requestPermission().then(function (permission) {
                    if (permission === 'granted') showNotif();
                });
            }
        }


        /* =========================================================
           LIVE ECO-PRODUCT INTERACTION
           - mouseover  -> preview product and highlight card
           - mouseout   -> restore card appearance
           - dblclick   -> select product and mark it selected
           - change     -> update demo quantity and total
        ========================================================= */
        const ecoProducts = {
            free: {
                name: 'Eco Reusable Water Bottle',
                price: 0,
                benefit: 'Free bottle-swap option. Reusable and travel friendly.',
                emoji: '🔄'
            },
            cloth: {
                name: 'Eco-Friendly Jute Carry Bag',
                price: 10,
                benefit: 'Reusable jute bag for carrying snacks and travel items.',
                emoji: '🛍️'
            },
            metal: {
                name: 'Stainless Steel Thermal Flask',
                price: 200,
                benefit: 'Reusable thermal flask for carrying drinking water.',
                emoji: '🍶'
            },
            smart: {
                name: 'Smart QR Eco Canteen',
                price: 500,
                benefit: 'Premium reusable canteen concept with smart QR features.',
                emoji: '⭐'
            }
        };

        let selectedEcoProduct = 'free';

        function updateEcoPreview(type, message) {
            const product = ecoProducts[type];
            if (!product) return;

            selectedEcoProduct = type;

            const name = document.getElementById('eco-preview-name');
            const benefit = document.getElementById('eco-preview-benefit');
            const total = document.getElementById('eco-total');
            const status = document.getElementById('eco-interaction-message');
            const preview = document.getElementById('eco-preview');

            if (!name || !benefit || !total) return;

            name.textContent = `${product.emoji} ${product.name}`;
            benefit.textContent = product.benefit;
            status.textContent = message || `Selected: ${product.name}`;

            const qty = Number(document.getElementById('eco-qty')?.value || 1);
            total.textContent = `₹${product.price * qty}`;

            preview.classList.remove('flash');
            void preview.offsetWidth;
            preview.classList.add('flash');
        }

        function confirmEcoSelection() {
            const product = ecoProducts[selectedEcoProduct];
            if (!product) return;

            acceptEcoProduct(selectedEcoProduct);
            localStorage.setItem('ootyEcoChoice', selectedEcoProduct);

            const message = document.getElementById('eco-interaction-message');
            if (message) {
                message.textContent = `✓ ${product.name} selected for your demo E-Pass.`;
            }

            document.querySelectorAll('.eco-product-card').forEach(function(card) {
                card.classList.toggle(
                    'selected',
                    card.dataset.productType === selectedEcoProduct
                );
            });
        }

        // MOUSEOVER + MOUSEOUT + DOUBLE-CLICK on eco products
        document.querySelectorAll('.eco-product-card').forEach(function(card) {
            const type = card.dataset.productType;

            card.addEventListener('mouseover', function () {
                card.classList.add('event-hover');
                updateEcoPreview(type, `Mouseover: previewing ${ecoProducts[type].name}.`);
            });

            card.addEventListener('mouseout', function () {
                card.classList.remove('event-hover');
                const message = document.getElementById('eco-interaction-message');
                if (message) {
                    message.textContent = 'Mouseout: move to another product or double-click to select.';
                }
            });

            card.addEventListener('dblclick', function (event) {
                event.preventDefault();
                updateEcoPreview(type, `Double-click: ${ecoProducts[type].name} selected.`);
                confirmEcoSelection();
            });
        });

        // CHANGE EVENT for product quantity
        const ecoQty = document.getElementById('eco-qty');
        if (ecoQty) {
            ecoQty.addEventListener('change', function () {
                const product = ecoProducts[selectedEcoProduct];
                const total = document.getElementById('eco-total');
                const message = document.getElementById('eco-interaction-message');

                if (product && total) {
                    total.textContent = `₹${product.price * Number(this.value)}`;
                }

                if (message) {
                    message.textContent = `Quantity changed to ${this.value}. Demo total updated live.`;
                }
            });
        }

        /* =========================================================
           ADDITIONAL EVENT HANDLING
           resize -> live viewport information
           mouseover / mouseout -> highlight gallery cards
        ========================================================= */

        function updateViewportInfo() {
            const viewport = document.getElementById('viewport-info');
            if (viewport) {
                viewport.textContent = `VIEWPORT: ${window.innerWidth} × ${window.innerHeight} px`;
            }
        }

        window.addEventListener('resize', function () {
            updateViewportInfo();
            const status = document.getElementById('event-status-text');
            if (status) {
                status.textContent = `Resize event: browser width is ${window.innerWidth}px.`;
            }
        });

        document.querySelectorAll('[data-event-card="true"]').forEach(function (card) {
            card.addEventListener('mouseover', function () {
                card.classList.add('event-hover');
                const status = document.getElementById('event-status-text');
                if (status) {
                    const title = card.querySelector('h3');
                    status.textContent = title
                        ? `Mouseover event: viewing "${title.textContent}".`
                        : 'Mouseover event: feature highlighted.';
                }
            });

            card.addEventListener('mouseout', function () {
                card.classList.remove('event-hover');
                const status = document.getElementById('event-status-text');
                if (status) {
                    status.textContent = 'Mouseout event: card returned to its original appearance.';
                }
            });
        });

        /* =========================================================
           HTML5 API 4: CLIPBOARD API
           Lets the tourist copy their generated Pass ID with one tap
           so it can be pasted into WhatsApp/SMS for the family.
        ========================================================= */
        function copyPassId() {
            const passText = document.getElementById('res-pass-id').textContent.replace('PASS ID: ', '').trim();
            const btn = document.getElementById('copy-pass-btn');

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(passText).then(function () {
                    const original = btn.innerHTML;
                    btn.innerHTML = '<span>✅</span> Copied!';
                    setTimeout(function () { btn.innerHTML = original; }, 2000);
                }).catch(function () {
                    alert('Clipboard API permission denied. Pass ID: ' + passText);
                });
            } else {
                alert('Clipboard API not supported. Pass ID: ' + passText);
            }
        }

        /* =========================================================
           HTML5 API 5: FULLSCREEN API
           Expands the live AI checkpost scanner into fullscreen so
           checkpost staff can view detections on a larger display.
        ========================================================= */
        function toggleScannerFullscreen() {
            const target = document.getElementById('scanner-fullscreen-target');
            const btn = document.getElementById('fullscreen-btn');

            if (!document.fullscreenElement) {
                if (target.requestFullscreen) {
                    target.requestFullscreen();
                } else {
                    alert('Fullscreen API not supported on this browser.');
                    return;
                }
                btn.textContent = '⤡';
            } else {
                document.exitFullscreen();
                btn.textContent = '⛶';
            }
        }

        document.addEventListener('fullscreenchange', function () {
            const btn = document.getElementById('fullscreen-btn');
            if (!document.fullscreenElement) btn.textContent = '⛶';
        });

        // On load: check for a previously saved E-Pass (Local Storage API)
        window.addEventListener('DOMContentLoaded', refreshSavedPassBanner);

        /* =========================================================
           CLICK-TO-EXPLORE API INFO MODAL
           Clicking any badge in the "HTML5 APIs Powering This Portal"
           strip opens a card explaining that API and lets the tourist
           trigger the matching live feature immediately.
        ========================================================= */
        const apiInfo = {
            geolocation: {
                icon: '📍',
                title: 'Geolocation API',
                desc: 'Reads the tourist\'s live device coordinates (with their permission) so the portal can work out how far away they are from each Nilgiris checkpost.',
                usage: 'Powers the "Locate Nearest Gate" button in the hero section — it calculates the closest of the 5 checkposts using the Haversine distance formula.',
                methods: 'navigator.geolocation.getCurrentPosition(success, error)'
            },
            storage: {
                icon: '💾',
                title: 'Local Storage API',
                desc: 'Saves small pieces of data directly in the tourist\'s browser so information survives a page reload or a return visit — no server or login needed.',
                usage: 'Used to remember the generated E-Pass (ID, vehicle number, checkpost) and the tourist\'s last chosen eco-product, shown as a "saved pass found" banner above the form.',
                methods: 'localStorage.setItem(key, value) / localStorage.getItem(key)'
            },
            notification: {
                icon: '🔔',
                title: 'Web Notifications API',
                desc: 'Shows a native, OS-level popup notification outside the browser tab — the same way apps alert you to messages — so violation alerts are hard to miss.',
                usage: 'Fires automatically whenever the AI scanner flags a prohibited plastic item (Bottle / Spoon / Plate / Cup), in addition to the on-page modal.',
                methods: 'Notification.requestPermission() / new Notification(title, options)'
            },
            clipboard: {
                icon: '📋',
                title: 'Clipboard API',
                desc: 'Lets a page copy text straight to the system clipboard with one click, instead of asking the tourist to manually select and copy it.',
                usage: 'Used on the "Copy Pass ID" button inside the generated E-Pass card, so tourists can quickly paste their Pass ID into WhatsApp or SMS to share with family.',
                methods: 'navigator.clipboard.writeText(text)'
            },
            fullscreen: {
                icon: '⛶',
                title: 'Fullscreen API',
                desc: 'Expands a chosen element to fill the entire screen, hiding browser chrome — useful for kiosk-style or large-display viewing at a checkpost booth.',
                usage: 'Used on the ⛶ button on the AI Checkpost Camera Simulator card, so staff can expand the live scanner view for a bigger display.',
                methods: 'element.requestFullscreen() / document.exitFullscreen()'
            }
        };

        let activeApiDemo = null;

        function showApiInfo(key) {
            const data = apiInfo[key];
            if (!data) return;
            activeApiDemo = key;

            document.getElementById('api-info-icon').textContent = data.icon;
            document.getElementById('api-info-title').textContent = data.title;
            document.getElementById('api-info-desc').textContent = data.desc;
            document.getElementById('api-info-usage').textContent = data.usage;
            document.getElementById('api-info-methods').textContent = data.methods;

            const modal = document.getElementById('api-info-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeApiInfo() {
            const modal = document.getElementById('api-info-modal');
            modal.classList.remove('flex');
            modal.classList.add('hidden');
        }

        function tryApiDemo() {
            closeApiInfo();

            if (activeApiDemo === 'geolocation') {
                document.getElementById('home').scrollIntoView({ behavior: 'smooth' });
                setTimeout(findNearestCheckpost, 400);
            } else if (activeApiDemo === 'storage') {
                document.getElementById('epass-form').scrollIntoView({ behavior: 'smooth' });
                refreshSavedPassBanner();
            } else if (activeApiDemo === 'notification') {
                document.getElementById('scanner').scrollIntoView({ behavior: 'smooth' });
                setTimeout(function () { selectPlastic('bottle', '🍾', 'Single-Use Water Bottle', '98.6%'); }, 400);
            } else if (activeApiDemo === 'clipboard') {
                document.getElementById('epass-form').scrollIntoView({ behavior: 'smooth' });
                if (document.getElementById('epass-result').classList.contains('hidden')) {
                    alert('Generate an E-Pass first using the form, then use "Copy Pass ID" on the result card.');
                } else {
                    copyPassId();
                }
            } else if (activeApiDemo === 'fullscreen') {
                document.getElementById('scanner').scrollIntoView({ behavior: 'smooth' });
                setTimeout(toggleScannerFullscreen, 400);
            }
        }
    

        /* =========================================================
           CREATIVE FEATURE: DARK MODE TOGGLE
           Stores the user's theme preference using Local Storage,
           which is already one of the five required HTML5 APIs.
        ========================================================= */
        function applyTheme(theme) {
            const isDark = theme === 'dark';
            document.body.classList.toggle('dark-mode', isDark);

            const icon = document.getElementById('darkModeIcon');
            const text = document.getElementById('darkModeText');
            const button = document.getElementById('darkModeToggle');

            if (icon) icon.textContent = isDark ? '☀️' : '🌙';
            if (text) text.textContent = isDark ? 'Light' : 'Dark';
            if (button) button.setAttribute('aria-pressed', String(isDark));
        }

        function toggleDarkMode() {
            const isDark = document.body.classList.toggle('dark-mode');
            const theme = isDark ? 'dark' : 'light';

            try {
                localStorage.setItem('ootyEcoTheme', theme);
            } catch (error) {
                console.warn('Theme preference could not be saved.');
            }

            applyTheme(theme);
        }

        function loadThemePreference() {
            let theme = 'light';

            try {
                theme = localStorage.getItem('ootyEcoTheme') || 'light';
            } catch (error) {
                theme = 'light';
            }

            applyTheme(theme);
        }

        window.addEventListener('DOMContentLoaded', function () {
            loadThemePreference();
            updateEcoPreview('free', 'Ready: hover, double-click, or use Select Eco Product.');
        });

    </script>
</body>
</html>
