        /* =========================================================
           HTML5 API 1: GEOLOCATION API
           Finds the tourist's current position and recommends the
           nearest of the 5 Nilgiris checkposts using the Haversine
           distance formula.
        ========================================================= */
        const checkpostCoords = [
            { name: 'Kallar Gate (Mettupalayam Road)', lat: 11.3757, lng: 76.8607 },
            { name: 'Kunjapanai Gate (Kotagiri Road)', lat: 11.4780, lng: 76.8935 },
            { name: 'Masinagudi Gate (Tiger Reserve)', lat: 11.5665, lng: 76.6480 },
            { name: 'Mel Gudalur Gate', lat: 11.5000, lng: 76.5500 },
            { name: 'Geddai Gate', lat: 11.4200, lng: 76.7200 }
        ];

        function toRad(deg) { return deg * (Math.PI / 180); }

        function haversineKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = toRad(lat2 - lat1);
            const dLon = toRad(lon2 - lon1);
            const a = Math.sin(dLat / 2) ** 2 +
                Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function findNearestCheckpost() {
            const resultEl = document.getElementById('geo-result');
            const btn = document.getElementById('geo-btn');

            if (!('geolocation' in navigator)) {
                resultEl.textContent = 'Geolocation API is not supported on this browser.';
                return;
            }

            btn.textContent = 'Locating…';
            resultEl.textContent = 'Requesting device location permission…';

            navigator.geolocation.getCurrentPosition(function (position) {
                const { latitude, longitude } = position.coords;
                let nearest = null;
                let nearestDist = Infinity;

                checkpostCoords.forEach(function (cp) {
                    const dist = haversineKm(latitude, longitude, cp.lat, cp.lng);
                    if (dist < nearestDist) {
                        nearestDist = dist;
                        nearest = cp;
                    }
                });

                resultEl.textContent = `📍 Nearest checkpost: ${nearest.name} — approx. ${nearestDist.toFixed(1)} km away.`;
                btn.textContent = 'Locate Nearest Gate';
            }, function (error) {
                resultEl.textContent = 'Location access denied or unavailable. Enable location permission to use this feature.';
                btn.textContent = 'Locate Nearest Gate';
            }, { enableHighAccuracy: true, timeout: 10000 });
        }

