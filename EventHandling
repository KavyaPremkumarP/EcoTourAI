    <!-- Custom CSS & Advanced Animations -->
    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            overflow-x: hidden;
        }

        /* FADE & SLIDE ANIMATIONS */
        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .fade-up { animation: fadeUp 1s ease-out forwards; }

        /* FLOATING EMOJIS & CARDS */
        @keyframes float {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-12px) rotate(3deg); }
        }
        .float-animation { animation: float 4s ease-in-out infinite; }

        @keyframes floatSlow {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-18px) rotate(-4deg); }
        }
        .float-slow { animation: floatSlow 6s ease-in-out infinite; }

        /* Floating plastic items */
        @keyframes floatPlastic1 {
            0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); }
            50% { transform: translateY(-20px) rotate(12deg) scale(1.05); }
        }
        @keyframes floatPlastic2 {
            0%, 100% { transform: translateY(0px) rotate(0deg) scale(1); }
            50% { transform: translateY(-25px) rotate(-15deg) scale(0.95); }
        }

        .plastic-float-1 { animation: floatPlastic1 5s ease-in-out infinite; }
        .plastic-float-2 { animation: floatPlastic2 6.5s ease-in-out infinite 1s; }

        /* LASER SCAN BEAM */
        @keyframes laserBeam {
            0% { top: 0%; opacity: 0.8; }
            50% { top: 100%; opacity: 1; }
            100% { top: 0%; opacity: 0.8; }
        }
        .laser-scan {
            position: absolute;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, transparent, #4ade80, #22c55e, #4ade80, transparent);
            box-shadow: 0 0 15px #4ade80, 0 0 30px #22c55e;
            animation: laserBeam 2.5s ease-in-out infinite;
            z-index: 20;
        }

        /* RADAR SWEEP */
        @keyframes radarSweep {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .radar-sweep {
            background: conic-gradient(from 0deg, rgba(74, 222, 128, 0.4) 0deg, transparent 60deg, transparent 360deg);
            animation: radarSweep 4s linear infinite;
        }

        /* GLOW ANIMATIONS */
        @keyframes glow {
            0%, 100% { box-shadow: 0 0 20px rgba(74, 222, 128, 0.2); }
            50% { shadow: 0 0 45px rgba(74, 222, 128, 0.5); }
        }
        .glow-animation { animation: glow 3s ease-in-out infinite; }

        /* RED ALERT PULSE */
        @keyframes alertPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            50% { box-shadow: 0 0 0 15px rgba(239, 68, 68, 0); }
        }
        .alert-pulse-btn { animation: alertPulse 2s infinite; }

        /* LIVE PULSE */
        @keyframes livePulse {
            0% { transform: scale(1); opacity: 1; }
            50% { transform: scale(1.08); opacity: 0.7; }
            100% { transform: scale(1); opacity: 1; }
        }
        .live-animation { animation: livePulse 2s infinite; }

        /* SCROLL REVEAL */
        .reveal {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .reveal.show {
            opacity: 1;
            transform: translateY(0);
        }
    </style>

